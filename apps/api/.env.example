# Umbral API - variables de entorno. Copia a `.env` (ignorado por git). NO pongas secretos reales en el repo.

# --- Datos
# Carpeta de un snapshot concreto (data/snapshots/<id>). Vacío = el más reciente en UMBRAL_SNAPSHOTS_ROOT;
# si no hay ninguno y UMBRAL_ALLOW_FIXTURE=1 se sirve el fixture etiquetado (apps/api/fixtures).
UMBRAL_SNAPSHOT_DIR=
UMBRAL_SNAPSHOTS_ROOT=
UMBRAL_ALLOW_FIXTURE=1
# 1 = no arrancar si el manifest SHA-256 o el hash de predicciones de Laya no coinciden (recomendado en web)
UMBRAL_STRICT_INTEGRITY=0

# --- Modos
# 1 = modo sin conexión: bloquea Gemini/ChatGPT/Claude (borradores recuperados o plantilla)
UMBRAL_OFFLINE=0
# 1 = habilita adaptadores ChatGPT/Claude solo para peticiones desde localhost (en la web debe ser 0)
UMBRAL_LOCAL_MODE=1
# local = usuario único | firebase = Authorization: Bearer <ID token de Firebase Auth anónima> | dev-header = X-Umbral-User (solo pruebas)
# public = acceso sin Firebase Auth; exige LOCAL_MODE=0 y PERSISTENCE=none
UMBRAL_AUTH_MODE=local
# Solo public + LOCAL_MODE=0, detrás de Cloudflare verificado. Deshabilitado por defecto.
# Si CF-Connecting-IP falta o es inválido, todos los visitantes del mismo proxy comparten el límite por IP.
# Arrancar Uvicorn con --no-proxy-headers; no usar forwarded-allow-ips='*'.
UMBRAL_TRUST_CLOUDFLARE_IP=0
# Secreto efímero para el sidecar de escritorio (lo crea Electron; no guardarlo en archivos)
UMBRAL_DESKTOP_TOKEN=
UMBRAL_HOST=127.0.0.1
UMBRAL_PORT=8000
UMBRAL_WEB_DIST=
UMBRAL_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# --- Persistencia: sqlite (local) | firestore (web con Auth) | memory (pruebas) | none (web pública)
UMBRAL_PERSISTENCE=sqlite
UMBRAL_SQLITE_PATH=
# Proyecto Firebase del equipo (Auth anónima + Firestore, plan Spark)
FIREBASE_PROJECT_ID=site-umbral
# Ruta a la cuenta de servicio (FUERA del repo). Solo en el servidor (Render); nunca se versiona.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Gemini (Free Tier, proyecto SIN facturación)
GEMINI_API_KEY=
# Por defecto gemini-3.1-flash-lite (validado, D-13; ~15 s por borrador estructurado). Opción más rápida medida el
# 2026-10-07: GEMINI_MODEL=gemini-flash-lite-latest (~7 s). RIESGO: «latest» es un alias móvil; Google puede cambiar el modelo
# detrás sin aviso y los resultados dejan de ser reproducibles. gemini-3.8-flash daba timeout (>45 s) con esta clave.
GEMINI_MODEL=gemini-3.1-flash-lite
# Respaldo opcional del MISMO Free Tier (vacío por defecto; evita reintentos y consumo ante fallos)
GEMINI_FALLBACK_MODEL=
GEMINI_CALLS_PER_USER_DAY=20
# Público: 0..20 GLOBAL/día UTC; transacción Firestore, incluye todos los reintentos
GEMINI_GLOBAL_CALLS_PER_DAY=20
GEMINI_TIMEOUT_S=30
# Opcional: 0 desactiva el «thinking» (más rápido) en modelos que lo admiten; vacío = valor por defecto del modelo
GEMINI_THINKING_BUDGET=

# --- Conexiones personales (opcionales, SOLO localhost; no requieren credenciales para ejecutar la entrega)
CHATGPT_TOKEN_FILE=
# Almacén gestionado OAuth/perfiles: por defecto ~/.umbral-connections/chatgpt.dat (FUERA del repo).
# Windows: DPAPI del usuario; Unix: directorio 0700 y archivo 0600. No requiere client secret.
CHATGPT_CREDENTIALS_FILE=
# Modelo elegido del catálogo de la cuenta OAuth (sin modelo personal automático)
CHATGPT_MODEL=
CLAUDE_CLI=claude
CLAUDE_MODEL=

# --- Exportación heredada a Notion (opcional, SOLO localhost y auth local)
# Crea una integración interna, comparte con ella la página destino y configura ambas variables en apps/api/.env.
# El token nunca se devuelve a la interfaz ni se registra en logs.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# --- Conectores OAuth públicos (opcionales; credenciales en entorno del API, no en el repo)
# Notion: crea una conexión pública OAuth y registra este callback exacto en el Developer Portal.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=
# Slack: bot scopes mínimos: chat:write, channels:read, groups:read. Registra el callback en Slack API.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=
# Clave AES-256 en Base64 URL-safe; genera una clave fuera del repo y guárdala como secreto del API.
CONNECTOR_ENCRYPTION_KEY=

# --- Límites por usuario (ventana de 1 minuto)
UMBRAL_QUERIES_PER_MINUTE=30
UMBRAL_DRAFTS_PER_MINUTE=10
# En público se limita siempre a máximo 2 borradores/minuto por IP.

# --- Datos online: misma URL HTTPS fija por instalación, sin redirecciones ni credenciales
UMBRAL_SNAPSHOT_FEED_URL=
UMBRAL_SNAPSHOT_REFRESH_S=900
UMBRAL_SNAPSHOT_STALE_HOURS=36
# Escritorio: generación vía servidor público, sin clave Gemini dentro del instalador
UMBRAL_PUBLIC_API_URL=

# --- SOLO PRUEBAS: simula Gemini sin red (ok | quota | down | no_key). Prohibido con auth firebase/public.
UMBRAL_GEMINI_STUB=
# Fija "ahora" para puntuar (ISO UTC); por defecto se usa el corte del snapshot
UMBRAL_NOW_OVERRIDE=
# Artefactos MiniLM precalculados opcionales; desactivar para usar el corpus léxico original.
UMBRAL_SEMANTIC_ENABLED=1
# UMBRAL_SEMANTIC_ROOT=data/agrupacion
