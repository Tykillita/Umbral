---
// Flecha SVG para la navegación de las páginas del jurado. Los caracteres «←» y «→» se pintan como emoji en algunos
// sistemas (iOS); el SVG se ve igual en todos, hereda el color del texto y no lo leen los lectores de pantalla.
interface Props { direction: 'left' | 'right'; }
const { direction } = Astro.props;
---
<svg class="jury-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  {direction === 'left'
    ? <><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></>
    : <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>}
</svg>
