---
import '../styles/global.css';
import DesktopWindowControls from '../components/DesktopWindowControls';
import DesktopUpdateNotice from '../components/DesktopUpdateNotice';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/atkinson-hyperlegible/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-700.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Umbral: agenda editorial priorizada, evidencia trazable y borradores para revisión humana (TVN Media).' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff7df" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/brand/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/brand/favicon-16.png" sizes="16x16" />
    <title>{title}</title>
    <script is:inline>
      // En la app de escritorio la cabecera ya nace fija y con su hueco reservado, sin parpadeo al hidratar.
      if (window.umbralDesktop && window.umbralDesktop.windowControls) document.documentElement.classList.add('desktop-shell');
      const preferenceKey = 'umbral.motion-preference.v1';
      const validPreference = (value) => value === 'system' || value === 'reduced' || value === 'full';
      let motionPreference = window.umbralDesktop && window.umbralDesktop.motionPreference;
      if (!validPreference(motionPreference)) {
        try { motionPreference = window.localStorage.getItem(preferenceKey); } catch { /* storage may be unavailable */ }
      }
      document.documentElement.dataset.motionPreference = validPreference(motionPreference) ? motionPreference : 'system';

      const themePreferenceKey = 'umbral.theme.v1';
      let themePreference;
      try { themePreference = window.localStorage.getItem(themePreferenceKey); } catch { /* el tema original sigue disponible */ }
      const activeTheme = themePreference === 'tvn' ? 'tvn' : 'original';
      document.documentElement.dataset.theme = activeTheme;
      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.content = activeTheme === 'tvn' ? '#F3F8FC' : '#FFF7DF';
    </script>
  </head>
  <body>
    <DesktopWindowControls client:only="react" />
    <DesktopUpdateNotice client:only="react" />
    <slot />
  </body>
</html>
