# Copia a .env.local para desarrollo. NUNCA subas claves reales.
# Los valores PUBLIC_* quedan embebidos en el bundle del navegador (no son secretos).

# URL base de la API. Vacío = mismo origen (FastAPI sirve dist/ en local; en `pnpm dev` el proxy envía /api a localhost:8000).
# Firebase Hosting + Render: https://<tu-servicio>.onrender.com
PUBLIC_API_URL=

# live = siempre API real | mock = siempre datos de demostración del frontend | auto = API real y, si no responde, mock con banner
# (por defecto: auto en `pnpm dev`, live en build de producción)
PUBLIC_API_MODE=

# local = usuario único sin SDK ni llamadas Firebase (también offline).
# firebase = sesión anónima obligatoria; configuración o sesión inválida bloquea la app.
# public = trabajo editorial sin cuenta visible; Firebase anónimo se inicializa solo al conectar un servicio externo.
# auto = Firebase si hay cualquier campo configurado, local si no hay ninguno.
# Elige firebase para Hosting/Render y local para scripts/start-local. Se fija al construir el frontend.
PUBLIC_AUTH_MODE=auto

# Firebase Auth anónima: los cuatro campos son obligatorios en modo firebase.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Solo verificación local con Firebase Emulator Suite; vacío en Hosting/Render.
# Rechazado si la app o este destino no están en localhost.
PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Solo servidor de desarrollo (Astro/Vite): destino del proxy /api
UMBRAL_API_PROXY=http://localhost:8000

# Mesa opcional: Supabase permite lectura e inserción; los roles son demo sin contraseña.
# Solo clave pública anon o publishable. Nunca service_role ni sb_secret_* en PUBLIC_*.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
